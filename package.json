{
  "name": "origami-simulator-cli",
  "version": "2.47.3",
  "description": "FOLD-to-finish toolchain for paper folding and paper craft: analyze, validate, render and export FOLD/SVG/DXF/STL via CLI, MCP or an agent skill.",
  "main": "src/index.js",
  "bin": {
    "origami": "./src/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/82412756bn-spec/origami-simulator-cli.git"
  },
  "homepage": "https://github.com/82412756bn-spec/origami-simulator-cli#readme",
  "bugs": {
    "url": "https://github.com/82412756bn-spec/origami-simulator-cli/issues"
  },
  "files": [
    "src/*.js",
    "src/commands/",
    "src/utils/",
    "src/templates/",
    "src/api/",
    "src/mcp/",
    "scripts/",
    "docs/",
    "examples/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "start": "node src/index.js",
    "test": "jest tests/unit",
    "test:e2e": "node tests/e2e/run-e2e.js",
    "test:e2e:browser": "playwright test",
    "test:all": "jest --testTimeout=180000",
    "lint": "eslint src/"
  },
  "keywords": [
    "origami",
    "paper-folding",
    "fold-format",
    "dieline",
    "packaging",
    "dxf",
    "stl",
    "3d-printing",
    "cli",
    "mcp",
    "agent-tools",
    "fold-analyzer",
    "json-schema"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.20.0",
    "commander": "^14.0.3",
    "earcut": "^3.0.2",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.59.1",
    "three": "^0.184.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "optionalDependencies": {
    "canvas": "^3.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "jest": "^30.3.0"
  }
}
